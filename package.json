{
  "name": "medical-supplier-erp-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c red,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:backend": "node scripts/backend-dev.mjs",
    "dev:api": "tsx watch server/index.ts",
    "dev:server": "npm run dev:api",
    "server": "tsx server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && npm run typecheck:api && vite build",
    "typecheck:api": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "tsx --test src/utils/precise.test.ts src/lib/auth/queryScope.test.ts src/domains/imports/costing.test.ts src/lib/permissions/effectiveAccess.test.ts src/domains/employees/employeeReports.test.ts src/domains/reports/reportFilters.test.ts server/salesWorkspace.test.ts server/runtime-mode.test.ts server/foundation/foundation.test.ts server/operations/operations.test.ts server/operations/hosted.test.ts server/trading/trading.test.ts server/trading/hosted.test.ts server/trading/transactions.hosted.test.ts server/finance/finance.test.ts server/finance/hosted.test.ts server/printing/printing.test.ts server/printing/hosted.test.ts server/reports/reports.test.ts server/reports/hosted.test.ts server/reports/reconciliation.hosted.test.ts server/workforce/workforce.test.ts server/workforce/hosted.test.ts",
    "test:allocation": "tsx --test src/domains/imports/costing.test.ts",
    "test:flows": "node scripts/api-flow.mjs",
    "check:backend": "tsx scripts/backend-readiness.mjs",
    "db:generate": "drizzle-kit generate",
    "db:backup": "tsx scripts/database.ts backup",
    "db:migrate": "tsx scripts/database.ts migrate",
    "backend:bootstrap": "tsx scripts/backend-bootstrap.ts",
    "backend:cleanup-tests": "tsx scripts/backend-test-cleanup.ts",
    "test:backend": "tsx --test server/foundation/foundation.test.ts",
    "test:imports-backend": "tsx --test server/operations/operations.test.ts server/operations/hosted.test.ts",
    "test:sales-backend": "tsx --test server/trading/trading.test.ts server/trading/hosted.test.ts server/trading/transactions.hosted.test.ts",
    "test:finance-backend": "tsx --test server/finance/finance.test.ts server/finance/hosted.test.ts",
    "test:print-backend": "tsx --test server/printing/printing.test.ts server/printing/hosted.test.ts",
    "test:reports-backend": "tsx --test server/reports/reports.test.ts server/reports/hosted.test.ts server/reports/reconciliation.hosted.test.ts",
    "check:print-layout": "tsx scripts/print-layout-check.ts",
    "test:workforce-backend": "tsx --test server/workforce/workforce.test.ts server/workforce/hosted.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:public": "node scripts/public-smoke.mjs",
    "smoke:website": "node scripts/website-content-smoke.mjs",
    "smoke:employee": "node scripts/employee-report-smoke.mjs",
    "smoke:sales": "node scripts/sales-lifecycle-smoke.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.0",
    "clsx": "^2.1.1",
    "cookie": "1.0.2",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.4",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.23.0",
    "pg": "8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "3.10.1",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.61.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.5.0",
    "globals": "^17.7.0",
    "supabase": "2.122.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16"
  }
}
